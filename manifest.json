{
  "manifest_version": 3,
  "name": "MPT4 Helper",
  "version": "0.11.4",
  "description": "Pembantu pengisian markah peperiksaan secara setempat dengan semakan dan pengesahan guru.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://mpt4-sbppa.moe.gov.my/marks/marks-entry*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buka MPT4 Helper",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*.otf"
      ],
      "matches": [
        "https://mpt4-sbppa.moe.gov.my/*"
      ]
    }
  ]
}
